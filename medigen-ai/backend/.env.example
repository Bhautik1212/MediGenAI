# Copy this file to ".env" (same folder) and edit. NEVER commit .env or share your token.

# auto | huggingface | local | comfyui | demo
#   auto        -> uses Hugging Face if HF_API_TOKEN is set, otherwise DEMO mode (placeholders, NOT AI)
#   huggingface -> hosted Stable Diffusion (free token, no GPU needed)
#   local       -> local Diffusers model (install requirements-local.txt; CPU is very slow)
#   comfyui     -> Qwen Image 2.1 GGUF using a local ComfyUI server
#   demo        -> clearly labelled placeholder images
GENERATION_MODE=auto

# Free token: https://huggingface.co/settings/tokens  (type: "Read" or fine-grained with Inference permission)
HF_API_TOKEN=
HF_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
HF_TIMEOUT_SECONDS=120

# CPU-friendly fallback model (not Qwen; slow and lower quality on CPU).
LOCAL_MODEL_ID=segmind/tiny-sd
LOCAL_STEPS=4

# Qwen Image 2.1 quantized ComfyUI model.
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_UNET_NAME=qwen-image-2.1-UC-Q4_K_M.gguf
COMFYUI_CLIP_NAME=qwen3vl_8b_int8_convrot.safetensors
COMFYUI_VAE_NAME=qwen_image_2.1_vae_bf16.safetensors
COMFYUI_STEPS=25
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_POLL_INTERVAL_SECONDS=2

# Longest image side in pixels (multiple of 8). Smaller uses less CPU/RAM and is faster.
BASE_IMAGE_SIZE=384

MAX_IMAGES_PER_REQUEST=4
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
